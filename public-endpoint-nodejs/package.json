{
  "name": "public-endpoint-nodejs",
  "version": "1.0.0",
  "description": "Public API Gateway wrapper",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@aws-sdk/*",
    "package": "npm run build && cd dist && zip function.zip index.js",
    "test": "echo \"No tests specified yet\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@aws-sdk/lib-dynamodb": "^3.1017.0",
    "@types/aws-lambda": "^8.10.0"
  }
}
