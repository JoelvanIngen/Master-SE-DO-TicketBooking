{
  "name": "ticket-booking-repo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "fake-services-nodejs",
    "public-endpoint-nodejs",
    "infra"
  ],
  "scripts": {
    "asl-validate": "asl-validator --yaml-path ticket-booking.asl.json",
    "build": "npm run build:java && npm run build:infra",
    "build:java": "mvn -f booking-service-java/pom.xml clean package -DskipTests",
    "build:infra": "tsc",
    "cdk": "cdk",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky",
    "type-check": "npm exec --workspaces -- tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "artillery": "^2.0.30",
    "asl-validator": "^4.0.0",
    "esbuild": "0.27.3",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "lint-staged": {
    "*.{ts,js,json,yml,yaml,md,mjs,mts}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --fix"
    ],
    "*.asl.json": [
      "asl-validator --yaml-path"
    ]
  }
}
