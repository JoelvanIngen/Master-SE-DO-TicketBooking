{
  "Comment": "Ticket Booking Workflow",
  "StartAt": "Initialize",
  "States": {
    "Initialize": {
      "Type": "Pass",
      "Comment": "Flatten the input from API Gateway mapping",
      "Parameters": {
        "bookingReferenceId.$": "$.bookingReferenceId",
        "connectionId.$": "$.connectionId",
        "simulateBookingFailure.$": "$.body.simulateBookingFailure"
      },
      "Next": "Mark as Running"
    },
    "Mark as Running": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, simulateBookingFailure = :sbf, connectionId = :connId",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": { "S": "RUNNING" },
          ":sbf": { "S.$": "$.simulateBookingFailure" },
          ":connId": { "S.$": "$.connectionId" }
        }
      },
      "ResultPath": null,
      "Next": "Reserve Seats"
    },
    "Reserve Seats": {
      "Type": "Task",
      "Resource": "${ReserveSeatsArn}",
      "Comment": "Calls TS Reserve Seats",
      "Parameters": {
        "simulateBookingFailure.$": "$.simulateBookingFailure",
        "bookingReferenceId.$": "$.bookingReferenceId"
      },
      "ResultPath": "$.reservationInfo",
      "Catch": [
        {
          "ErrorEquals": ["ErrorSeatsNotAvailable"],
          "ResultPath": "$.errorInfo",
          "Next": "Save Seats Failure"
        }
      ],
      "Next": "Retrieve Payment"
    },
    "Retrieve Payment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${PAYMENT_REQUEST_QUEUE_URL}",
        "MessageBody": {
          "paymentRequestId.$": "States.UUID()",
          "taskToken.$": "$$.Task.Token",
          "simulateBookingFailure.$": "$.simulateBookingFailure",
          "bookingReferenceId.$": "$.bookingReferenceId"
        }
      },
      "TimeoutSeconds": 30,
      "ResultSelector": {
        "paymentConfirmationId.$": "$.paymentConfirmationId"
      },
      "ResultPath": "$.paymentInfo",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.errorInfo",
          "Next": "Save Timeout"
        }
      ],
      "Next": "Generate Ticket"
    },
    "Generate Ticket": {
      "Type": "Task",
      "Resource": "${GenerateTicketArn}",
      "Parameters": {
        "simulateBookingFailure.$": "$.simulateBookingFailure",
        "bookingReferenceId.$": "$.bookingReferenceId",
        "reservationId.$": "$.reservationInfo.reservationId"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "Save Ticket Error"
        }
      ],
      "ResultSelector": {
        "ticketId.$": "$.ticketId"
      },
      "ResultPath": "$.ticketInfo",
      "Next": "Save Success"
    },

    "Save Success": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, reservationId = :resId, paymentConfirmationId = :payId, ticketId = :ticketId, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "COMPLETED" },
          ":resId": { "S.$": "$.reservationInfo.reservationId" },
          ":payId": { "S.$": "$.paymentInfo.paymentConfirmationId" },
          ":ticketId": { "S.$": "$.ticketInfo.ticketId" },
          ":success": { "BOOL": true }
        }
      },
      "ResultPath": null,
      "Next": "Format Success Payload"
    },
    "Format Success Payload": {
      "Type": "Pass",
      "Parameters": {
        "status": "COMPLETED",
        "bookingReferenceId.$": "$.bookingReferenceId",
        "ticketId.$": "$.ticketInfo.ticketId",
        "reservationId.$": "$.reservationInfo.reservationId",
        "paymentConfirmationId.$": "$.paymentInfo.paymentConfirmationId",
        "success": true
      },
      "ResultPath": "$.wsPayload",
      "Next": "Notify Success"
    },
    "Notify Success": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "${WebSocketApiEndpoint}",
        "Method": "POST",
        "Stage": "prod",
        "Path.$": "States.Format('/@connections/{}', $.connectionId)",
        "RequestBody.$": "$.wsPayload",
        "AuthType": "IAM_ROLE"
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Booking Succeeded" }],
      "Next": "Booking Succeeded"
    },

    "Save Seats Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FAILED_SEATS_UNAVAILABLE" },
          ":success": { "BOOL": false }
        }
      },
      "ResultPath": null,
      "Next": "Format Seats Failure Payload"
    },
    "Format Seats Failure Payload": {
      "Type": "Pass",
      "Parameters": {
        "status": "FAILED_SEATS_UNAVAILABLE",
        "bookingReferenceId.$": "$.bookingReferenceId",
        "success": false
      },
      "ResultPath": "$.wsPayload",
      "Next": "Notify Seats Failure"
    },
    "Notify Seats Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "${WebSocketApiEndpoint}",
        "Method": "POST",
        "Stage": "prod",
        "Path.$": "States.Format('/@connections/{}', $.connectionId)",
        "RequestBody.$": "$.wsPayload",
        "AuthType": "IAM_ROLE"
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Booking Cancelled (Seats Not Available)" }
      ],
      "Next": "Booking Cancelled (Seats Not Available)"
    },

    "Save Timeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, reservationId = :resId, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FAILED_PAYMENT_TIMEOUT" },
          ":resId": { "S.$": "$.reservationInfo.reservationId" },
          ":success": { "BOOL": false }
        }
      },
      "ResultPath": null,
      "Next": "Format Timeout Payload"
    },
    "Format Timeout Payload": {
      "Type": "Pass",
      "Parameters": {
        "status": "FAILED_PAYMENT_TIMEOUT",
        "bookingReferenceId.$": "$.bookingReferenceId",
        "reservationId.$": "$.reservationInfo.reservationId",
        "success": false
      },
      "ResultPath": "$.wsPayload",
      "Next": "Notify Timeout"
    },
    "Notify Timeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "${WebSocketApiEndpoint}",
        "Method": "POST",
        "Stage": "prod",
        "Path.$": "States.Format('/@connections/{}', $.connectionId)",
        "RequestBody.$": "$.wsPayload",
        "AuthType": "IAM_ROLE"
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Booking Cancelled (Timeout)" }],
      "Next": "Booking Cancelled (Timeout)"
    },

    "Save Ticket Error": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, reservationId = :resId, paymentConfirmationId = :payId, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FAILED_TICKET_ERROR" },
          ":resId": { "S.$": "$.reservationInfo.reservationId" },
          ":payId": { "S.$": "$.paymentInfo.paymentConfirmationId" },
          ":success": { "BOOL": false }
        }
      },
      "ResultPath": null,
      "Next": "Format Ticket Error Payload"
    },
    "Format Ticket Error Payload": {
      "Type": "Pass",
      "Parameters": {
        "status": "FAILED_TICKET_ERROR",
        "bookingReferenceId.$": "$.bookingReferenceId",
        "reservationId.$": "$.reservationInfo.reservationId",
        "paymentConfirmationId.$": "$.paymentInfo.paymentConfirmationId",
        "success": false
      },
      "ResultPath": "$.wsPayload",
      "Next": "Notify Ticket Error"
    },
    "Notify Ticket Error": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "${WebSocketApiEndpoint}",
        "Method": "POST",
        "Stage": "prod",
        "Path.$": "States.Format('/@connections/{}', $.connectionId)",
        "RequestBody.$": "$.wsPayload",
        "AuthType": "IAM_ROLE"
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Booking Cancelled (Ticket Error)" }],
      "Next": "Booking Cancelled (Ticket Error)"
    },

    "Booking Succeeded": { "Type": "Succeed" },
    "Booking Cancelled (Seats Not Available)": { "Type": "Fail" },
    "Booking Cancelled (Timeout)": { "Type": "Fail", "Error": "PaymentTimeout" },
    "Booking Cancelled (Ticket Error)": { "Type": "Fail", "Error": "TicketGenerationFailed" }
  }
}
