{
  "Comment": "Ticket Booking Workflow",
  "StartAt": "Reserve Seats",
  "States": {
    "Reserve Seats": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-north-1:771772518287:function:reserveSeats:$LATEST",
      "Comment": "Calls TS Reserve Seats",
      "Parameters": {
        "simulateBookingFailure.$": "$.simulateBookingFailure",
        "bookingReferenceId.$": "$.bookingReferenceId"
      },
      "ResultPath": "$.reservationInfo",
      "Catch": [
        {
          "ErrorEquals": [
            "ErrorSeatsNotAvailable"
          ],
          "Next": "Booking Cancelled (Seats Not Available)"
        }
      ],
      "Next": "Retrieve Payment"
    },
    "Retrieve Payment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:eu-north-1:771772518287:function:retrievePayment:$LATEST",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "simulateBookingFailure.$": "$.simulateBookingFailure",
          "bookingReferenceId.$": "$.bookingReferenceId"
        }
      },
      "TimeoutSeconds": 30,
      "ResultSelector": {
        "paymentConfirmationId.$": "$.paymentConfirmationId"
      },
      "ResultPath": "$.paymentInfo",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "Next": "Booking Cancelled (Timeout)"
        }
      ],
      "Next": "Generate Ticket"
    },
    "Generate Ticket": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-north-1:771772518287:function:GenerateTicketHandler:$LATEST",
      "Parameters": {
        "simulateBookingFailure.$": "$.simulateBookingFailure",
        "bookingReferenceId.$": "$.bookingReferenceId",
        "reservationId.$": "$.reservationInfo.reservationId"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Booking Cancelled (Ticket Error)"
        }
      ],
      "ResultSelector": {
        "ticketId.$": "$.ticketId"
      },
      "ResultPath": "$.ticketInfo",
      "Next": "Booking Succeeded"
    },
    "Booking Succeeded": {
      "Type": "Succeed"
    },
    "Booking Cancelled (Seats Not Available)": {
      "Type": "Fail",
      "Error": "ErrorSeatsNotAvailable",
      "Cause": "Seats not available for this booking reference"
    },
    "Booking Cancelled (Timeout)": {
      "Type": "Fail",
      "Error": "PaymentTimeout",
      "Cause": "Payment not received within 30 seconds"
    },
    "Booking Cancelled (Ticket Error)": {
      "Type": "Fail",
      "Error": "TicketGenerationFailed",
      "Cause": "The ticket service is unavailable"
    }
  }
}