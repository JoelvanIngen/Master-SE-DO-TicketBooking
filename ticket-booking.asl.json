{
  "Comment": "Ticket Booking Workflow",
  "StartAt": "Mark as Running",
  "States": {
    "Mark as Running": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": { "bookingReferenceId": { "S.$": "$.bookingReferenceId" } },
        "UpdateExpression": "SET #status = :status",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": { ":status": { "S": "RUNNING" } }
      },
      "ResultPath": null,
      "Next": "Reserve Seats"
    },
    "Reserve Seats": {
      "Type": "Task",
      "Resource": "${ReserveSeatsArn}",
      "Comment": "Calls TS Reserve Seats",
      "Parameters": {
        "simulateBookingFailure.$": "$.simulateBookingFailure",
        "bookingReferenceId.$": "$.bookingReferenceId"
      },
      "ResultPath": "$.reservationInfo",
      "Catch": [
        {
          "ErrorEquals": ["ErrorSeatsNotAvailable"],
          "ResultPath": "$.errorInfo",
          "Next": "Save Seats Failure"
        }
      ],
      "Next": "Retrieve Payment"
    },
    "Retrieve Payment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${PAYMENT_REQUEST_QUEUE_URL}",
        "MessageBody": {
          "paymentRequestId.$": "States.UUID()",
          "taskToken.$": "$$.Task.Token",
          "simulateBookingFailure.$": "$.simulateBookingFailure",
          "bookingReferenceId.$": "$.bookingReferenceId"
        }
      },
      "TimeoutSeconds": 30,
      "ResultSelector": {
        "paymentConfirmationId.$": "$.paymentConfirmationId"
      },
      "ResultPath": "$.paymentInfo",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.errorInfo",
          "Next": "Save Timeout"
        }
      ],
      "Next": "Generate Ticket"
    },
    "Generate Ticket": {
      "Type": "Task",
      "Resource": "${GenerateTicketArn}",
      "Parameters": {
        "simulateBookingFailure.$": "$.simulateBookingFailure",
        "bookingReferenceId.$": "$.bookingReferenceId",
        "reservationId.$": "$.reservationInfo.reservationId"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "Save Ticket Error"
        }
      ],
      "ResultSelector": {
        "ticketId.$": "$.ticketId"
      },
      "ResultPath": "$.ticketInfo",
      "Next": "Save Success"
    },

    "Save Success": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, reservationId = :resId, paymentConfirmationId = :payId, ticketId = :ticketId, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "COMPLETED" },
          ":resId": { "S.$": "$.reservationInfo.reservationId" },
          ":payId": { "S.$": "$.paymentInfo.paymentConfirmationId" },
          ":ticketId": { "S.$": "$.ticketInfo.ticketId" },
          ":success": { "BOOL": true }
        }
      },
      "ResultPath": null,
      "Next": "Booking Succeeded"
    },
    "Save Seats Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FAILED_SEATS_UNAVAILABLE" },
          ":success": { "BOOL": false }
        }
      },
      "ResultPath": null,
      "Next": "Booking Cancelled (Seats Not Available)"
    },
    "Save Timeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, reservationId = :resId, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FAILED_PAYMENT_TIMEOUT" },
          ":resId": { "S.$": "$.reservationInfo.reservationId" },
          ":success": { "BOOL": false }
        }
      },
      "ResultPath": null,
      "Next": "Booking Cancelled (Timeout)"
    },
    "Save Ticket Error": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${BookingTableName}",
        "Key": {
          "bookingReferenceId": { "S.$": "$.bookingReferenceId" }
        },
        "UpdateExpression": "SET #status = :status, reservationId = :resId, paymentConfirmationId = :payId, success = :success",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FAILED_TICKET_ERROR" },
          ":resId": { "S.$": "$.reservationInfo.reservationId" },
          ":payId": { "S.$": "$.paymentInfo.paymentConfirmationId" },
          ":success": { "BOOL": false }
        }
      },
      "ResultPath": null,
      "Next": "Booking Cancelled (Ticket Error)"
    },

    "Booking Succeeded": {
      "Type": "Succeed"
    },
    "Booking Cancelled (Seats Not Available)": {
      "Type": "Fail"
    },
    "Booking Cancelled (Timeout)": {
      "Type": "Fail",
      "Error": "PaymentTimeout",
      "Cause": "Payment not received within 30 seconds"
    },
    "Booking Cancelled (Ticket Error)": {
      "Type": "Fail",
      "Error": "TicketGenerationFailed",
      "Cause": "The ticket service is unavailable"
    }
  }
}
